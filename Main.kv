<Ventilador>:
    name: "ventilador"

    MDLabel:
        text: "Tela Ventilador"
        halign: "center"

    MDIconButton:
        icon: "arrow-left"

        on_release:
            app.root.current = "aparelhos"
            app.root.transition.direction = "right"
            
<Ideias>:
    name: "ideias"

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(20)

        MDLabel:
            text: "Economia consciente"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]

        # CARROSSEL DE DICAS
        MDCarousel:
            id: dicas_carousel
            size_hint_y: None
            height: dp(180)

            FitImage:
                source: "Images/dica1.png"
                radius: [20,]

            FitImage:
                source: "Images/dica2.png"
                radius: [20,]

            FitImage:
                source: "Images/dica3.png"
                radius: [20,]

        MDLabel:
            text: "Pontos e recompensas"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]

        # CARDS DESLIZÁVEIS
        ScrollView:
            do_scroll_y: False
            do_scroll_x: True
            size_hint_y: None
            height: dp(140)

            MDBoxLayout:
                adaptive_width: True
                spacing: dp(15)
                padding: [0,0,20,0]

                MDCard:
                    size_hint: None, None
                    size: dp(120), dp(120)
                    radius: [15,]

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: dp(10)

                        MDLabel:
                            text: "Ler dicas"

                        MDLabel:
                            text: "+50 pontos"

                        MDRaisedButton:
                            text: "Resgatar"

                MDCard:
                    size_hint: None, None
                    size: dp(120), dp(120)
                    radius: [15,]

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: dp(10)

                        MDLabel:
                            text: "Economizar"

                        MDLabel:
                            text: "+200 pontos"

                MDCard:
                    size_hint: None, None
                    size: dp(120), dp(120)
                    radius: [15,]

        MDTextButton:
            text: "Ver prêmios"
            pos_hint: {"center_x": .15}

        MDLabel:
            text: "Meus hábitos"
            bold: True
            size_hint_y: None
            height: self.texture_size[1]

        MDRaisedButton:
            text: "▼ maio"
            size_hint: None, None
            size: dp(90), dp(40)
            md_bg_color: .85, .95, .88, 1
            text_color: .4, .7, .5, 1

        MDBoxLayout:
            spacing: dp(20)

            # LADO ESQUERDO
            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    text: "Economia mensal"
                    halign: "center"

                Widget:

                MDLabel:
                    text: "X %"
                    halign: "center"

                Widget:

            # LADO DIREITO
            MDBoxLayout:
                orientation: "vertical"

                MDLabel:
                    text: "Total economizado"

                MDLabel:
                    text: "XXX Kw"
                    font_size: "28sp"
                    bold: True

                MDLabel:
                    text: "Rendimento"

                MDChip:
                    text: "Positivo"

        Widget:

        # MENU INFERIOR
        MDBoxLayout:
            size_hint_y: None
            height: dp(60)
            spacing: dp(40)

            Widget:

            MDIconButton:
                icon:
                    "home" if root.manager.current == "home" else "home-outline"

                on_release:
                    root.manager.current = "home"
                    app.root.transition.direction = "right"

            MDIconButton:
                icon: "lightbulb"
                theme_bg_color: "Custom"
                md_bg_color: 0.85,0.75,1,1
                radius: [25,]

            MDIconButton:
                icon: "account"

            Widget: