TelaPrincipal:

<TelaPrincipal>:
    orientation: "vertical"
    spacing: 0
    padding: 0

    Gerenciador:
        id: screen_manager
        size_hint_y: 1

    # ============================================================
    # MENU INFERIOR GLOBAL (Travado com tamanho fixo perfeito)
    # ============================================================
    MDBoxLayout:
        size_hint_y: None
        height: dp(65)
        spacing: dp(35)
        padding: [dp(20), dp(20)]
        md_bg_color: 0.97, 0.97, 0.97, 1

        Widget:

        MDIconButton:
            icon: "Images/homepress.png" if screen_manager.current == "home" else "Images/home.png"
            border: 0, 0, 0, 0
            ripple_behavior: False
            icon_size: dp(40)
            theme_icon_color: "Custom"
            pos_hint: {"center_y": .5}
            on_release:
                screen_manager.transition.direction = "right"
                screen_manager.current = "home"

        MDIconButton:
            icon: "Images/dicapress.png" if screen_manager.current == "ideias" else "Images/dica.png"
            border: 0, 0, 0, 0
            ripple_behavior: False
            icon_size: dp(40)
            theme_icon_color: "Custom"
            pos_hint: {"center_y": .5}
            on_release:
                screen_manager.transition.direction = "left" if screen_manager.current == "home" else "right"
                screen_manager.current = "ideias"

        MDIconButton:
            icon: "Images/perfil.png"
            theme_icon_color: "Custom"
            border: 0, 0, 0, 0
            ripple_behavior: False
            icon_size: dp(40)
            pos_hint: {"center_y": .5}

        Widget:

<Gerenciador>:
    Home:
    Ideias:
    Historico:
    Aparelhos:
    Geladeira:
    Ventilador:

# ============================================================
# TELA HOME (Alinhada perfeitamente ao topo, sem vãos)
# ============================================================
<Home>:
    name: "home"

    BoxLayout:
        orientation: "vertical"
        spacing: 0
        padding: 0
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # SEÇÃO 1: CABEÇALHO IMAGEM DO TOPO
        MDFloatLayout:
            size_hint_y: None
            height: dp(140)

            Image:
                source: "images/fundo_grande.png"
                allow_stretch: True
                keep_ratio: False
                size_hint: 1, 1
                pos_hint: {"center_x": .5, "center_y": .5}

            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: dp(50)
                pos_hint: {"x": 0, "top": 0.85}
                padding: [dp(22), 0, dp(22), 0]

                MDLabel:
                    text: "Olá, Ana!"
                    font_size: dp(20)
                    bold: True
                    color: 0, 0, 0, 1
                    valign: "middle"

                Button:
                    background_normal: "images/bell.png"
                    background_down: "images/bellpress.png"
                    size_hint: None, None
                    size: dp(20), dp(20)
                    border: 0, 0, 0, 0
                    pos_hint: {"center_y": .5}

        # SEÇÃO 2: CONSUMO
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(130)
            padding: [dp(22), dp(15), dp(22), dp(5)]
            spacing: dp(20)

            MDLabel:
                text: "Consumo"
                font_size: dp(18)
                bold: True
                color: 0.2, 0.05, 0.18, 1
                size_hint_y: None
                height: self.texture_size[1]

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(20)
                size_hint_y: None
                height: dp(75)

                Button:
                    size_hint: None, None
                    size: dp(85), dp(85)
                    background_normal: "images/aparelhos.png"
                    background_down: "images/aparelhospress.png"
                    border: 0, 0, 0, 0
                    on_release:
                        app.root.ids.screen_manager.current = "aparelhos"
                        app.root.ids.screen_manager.transition.direction = "left"

                Button:
                    size_hint: None, None
                    size: dp(85), dp(85)
                    background_normal: "images/historico.png"
                    background_down: "images/historicopress.png"
                    border: 0, 0, 0, 0
                    on_release:
                        app.root.ids.screen_manager.current = "historico"
                        app.root.ids.screen_manager.transition.direction = "left"
                
                Button:
                    size_hint: None, None
                    size: dp(85), dp(85)
                    background_normal: "images/comunidade.png"
                    background_down: "images/comunidade.png"
                    border: 0, 0, 0, 0

        # SEÇÃO 3: HOJE (GRÁFICOS)
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(230)
            padding: [dp(22), dp(10), dp(10), dp(10)]
            spacing: dp(5)

            MDLabel:
                size_hint_y: None
                text: "Hoje"
                height: self.texture_size[1]
                color: 0.2, 0.05, 0.18, 1
                font_size: dp(18)
                bold: True

            MDFloatLayout:
                size_hint_y: None
                height: dp(180)

                MDCard:
                    orientation: "horizontal"
                    size_hint: 1, None
                    height: dp(170)
                    pos_hint: {"center_x": .5, "top": 1}
                    radius: [dp(20)]
                    spacing: dp(10)
                    md_bg_color: 0.97, 0.97, 0.97, 1

                    # Lado Esquerdo: Gauge
                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: 0.35

                        MDLabel:
                            text: root.nivel
                            halign: "center"
                            adaptive_height: True
                            bold: True
                            color: (0.3, 0.8, 0.5, 1) if root.nivel == "Baixo" else (1, 0.7, 0.2, 1) if root.nivel == "Médio" else (1, 0.3, 0.3, 1)

                        Widget:
                            size_hint_y: None
                            height: dp(5)

                        FloatLayout:
                            size_hint_y: None
                            height: dp(100)
                            canvas:
                                Color:
                                    rgba: 0.9, 0.9, 0.9, 1
                                Line:
                                    width: dp(8)
                                    circle: (self.center_x, self.center_y, dp(40))
                                Color:
                                    rgba: 0.4, 0.8, 0.7, 1
                                Line:
                                    width: dp(8)
                                    cap: "round"
                                    circle: (self.center_x, self.center_y, dp(40), 0, 360 * root.porcentagem)

                            MDLabel:
                                id: gauge_label
                                text: "0 kw/h"
                                halign: "center"
                                pos_hint: {"center_x": .5, "center_y": .5}
                                bold: True
                                font_size: dp(13)
                        Widget:

                    #LADO DIREITO: GRAFICOS
                    MDBoxLayout:
                        size_hint_y: None
                        size_hint_x: 0.65
                        height: dp(180)
                        spacing: dp(10)

                        # EIXO Y COM OS VALORES
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_x: None
                            width: dp(20)
                            padding: [0, dp(18), 0, dp(15)]

                            MDLabel:
                                text: "200"
                                font_size: dp(11)
                                halign: "right"
                                color: 0.6, 0.6, 0.6, 1
                            Widget:
                            MDLabel:
                                text: "100"
                                font_size: dp(11)
                                halign: "right"
                                color: 0.6, 0.6, 0.6, 1
                            Widget:
                            MDLabel:
                                text: "0"
                                font_size: dp(11)
                                halign: "right"
                                color: 0.6, 0.6, 0.6, 1

                        # CHÃO MATEMÁTICO
                        MDRelativeLayout:
                            canvas.before:
                                Color:
                                    rgba: 0.9, 0.9, 0.9, 0.6
                                Line:
                                    points: [0, self.height - dp(25), self.width, self.height - dp(25)]
                                    width: 1
                                    dash_length: dp(3)
                                    dash_offset: dp(3)

                                Color:
                                    rgba: 0.88, 0.88, 0.88, 1
                                Line:
                                    points: [0, (self.height - dp(45)) / 2 + dp(20), self.width, (self.height - dp(45)) / 2 + dp(20)]
                                    width: 1

                                Color:
                                    rgba: 0.35, 0.35, 0.35, 1
                                Line:
                                    points: [0, dp(20), self.width, dp(20)]
                                    width: 1.5

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(5)
                                size_hint: 1, 1
                                pos_hint: {"x": 0, "y": 0}

                                # HORÁRIO: 00h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_00h
                                            size_hint: (None, None)
                                            width: dp(20)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "00h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

                                # HORÁRIO: 04h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_04h
                                            size_hint: (None, None)
                                            width: dp(16)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "04h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

                                # HORÁRIO: 08h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_08h
                                            size_hint: (None, None)
                                            width: dp(16)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "08h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

                                # HORÁRIO: 12h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_12h
                                            size_hint: (None, None)
                                            width: dp(16)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "12h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

                                # HORÁRIO: 16h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_16h
                                            size_hint: (None, None)
                                            width: dp(16)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "16h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

                                # HORÁRIO: 20h
                                MDBoxLayout:
                                    orientation: "vertical"
                                    MDFloatLayout:
                                        Widget:
                                            id: barra_20h
                                            size_hint: (None, None)
                                            width: dp(16)
                                            pos_hint: {"center_x": .5, "y": 0.005}
                                            canvas.before:
                                                Color:
                                                    rgba: (0.5, 0.75, 0.68, 1) if self.size_hint_y and self.size_hint_y > 0 else (0.93, 0.93, 0.93, 1)
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(4), dp(4), 0, 0]
                                    MDLabel:
                                        text: "20h"
                                        halign: "center"
                                        font_size: dp(11)
                                        color: 0.5, 0.5, 0.5, 1
                                        size_hint_y: None
                                        height: dp(20)

        Widget:
            size_hint_y: 1



<Historico>:
    name: "historico"

    MDBoxLayout:
        orientation: "vertical"
        padding: [10,10,10,10]
        spacing: 10

        MDBoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)

            MDIconButton:
                icon: "arrow-left"
                ripple_behavior: False
                theme_icon_color: "Custom"
                icon_color: 0.2,0.05,0.18,1

                on_release:
                    app.root.ids.screen_manager.current = "home"
                    app.root.ids.screen_manager.transition.direction = "right"

            MDLabel:
                text: "Histórico"
                bold: True
                font_size: "24sp"
                color: 0.2,0.05,0.18,1

        MDBoxLayout:
            spacing: 15
            size_hint_y: None
            height: dp(30)

            MDFlatButton:
                text: "Diário"
                theme_bg_color: "Custom"

                md_bg_color:
                    (0.88,0.8,0.92,1) if root.modo == "diario" else (0.95,0.95,0.95,1)

                text_color:
                    (0.2,0.05,0.18,1)

                on_release:
                    root.carregar_diario()

            MDFlatButton:
                text: "Mensal"
                theme_bg_color: "Custom"

                md_bg_color:
                    (0.88,0.8,0.92,1) if root.modo == "mensal" else (0.95,0.95,0.95,1)

                text_color:
                    (0.2,0.05,0.18,1)

                on_release:
                    root.carregar_mensal()

            MDFlatButton:
                text: "Anual"
                theme_bg_color: "Custom"

                md_bg_color:
                    (0.88,0.8,0.92,1) if root.modo == "anual" else (0.95,0.95,0.95,1)

                text_color:
                    (0.2,0.05,0.18,1)

                on_release:
                    root.carregar_anual()

        Widget:
            size_hint_y: None
            height: 5

        MDBoxLayout:
            id: seletor
            size_hint_y: None
            height: dp(50)
            padding: [dp(20), 0]
            spacing: dp(5)
            
            # Centraliza o seletor na tela
            Widget:

            MDIconButton:
                icon: "chevron-left"
                ripple_behavior: False
                on_release: root.navegar_data(-1)
                pos_hint: {"center_y": .5}

            MDCard:
                id: fundo_data
                size_hint: None, None
                size: dp(140), dp(40)
                radius: [20]
                md_bg_color: 0.8, 0.9, 0.8, 1
                elevation: 0
                pos_hint: {"center_y": .5}
                on_release: root.acao_seletor()
                
                MDLabel:
                    text: root.dia_texto if root.modo == "diario" else (root.mes_texto if root.modo == "mensal" else root.ano_texto)
                    halign: "center"
                    valign: "center"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 0.2, 0.4, 0.3, 1 # Verde escuro

            MDIconButton:
                icon: "chevron-right"
                ripple_behavior: False
                on_release: root.navegar_data(1)
                pos_hint: {"center_y": .5}
                
            Widget:

        FloatLayout:
            size_hint_y: None
            height: 300

            canvas:
                Color:
                    rgba: 0.85,0.9,0.88,1

                Line:
                    width: 20
                    circle:
                        (self.center_x,
                        self.center_y + 10,
                        95,
                        -90,
                        90)

                Color:
                    rgba: 0.45,0.7,0.65,1

                Line:
                    width: 20
                    circle:
                        (self.center_x,
                        self.center_y + 10,
                        95,
                        -90,
                        (-90) + (180 * root.porcentagem))

            MDLabel:
                text: str(root.consumo)
                font_size: 42
                bold: True
                halign: "center"
                color: 0.2,0.05,0.18,1
                pos_hint: {"center_x": .5, "center_y": .48}

            MDLabel:
                text: root.unidade
                font_size: 20
                halign: "center"
                color: 0.7,0.7,0.7,1
                pos_hint: {"center_x": .5, "center_y": .32}

        MDBoxLayout:
            size_hint_y: None
            height: dp(150)
            spacing: 8
            pos_hint: {"x": -0.05}

            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: 35

                MDLabel:
                    text: "350"
                    font_size: 11
                    halign: "right"

                Widget:

                MDLabel:
                    text: "175"
                    font_size: 11
                    halign: "right"

                Widget:

                MDLabel:
                    text: "0"
                    font_size: 11
                    halign: "right"

            MDRelativeLayout:

                canvas.before:

                    # linha superior
                    Color:
                        rgba: 0.9,0.9,0.9,0.6

                    Line:
                        points: [ 0, self.height - dp(25), self.width, self.height - dp(25) ]
                        width: 1
                        dash_length: dp(3)
                        dash_offset: dp(3)


                    # linha do meio
                    Color:
                        rgba: 0.88,0.88,0.88,1

                    Line:
                        points: [ 0, self.center_y, self.width, self.center_y ]
                        width: 1


                    # chão
                    Color:
                        rgba: 0.35,0.35,0.35,1

                    Line:
                        points: [ 0, dp(20), self.width, dp(20) ]
                        width: 1.5

                MDBoxLayout:
                    id: container_barras
                    pos_hint: {"center_x": .5, "center_y": .33}
                    spacing: 6
                    size_hint_y: None

                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:

                            size_hint: None, None
                            width: dp(18)
                            height: root.barra1

                            pos_hint:
                                {"center_x": .5, "y": 0.11}

                            canvas.before:

                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(5)]

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text: "00h" if root.modo == "diario" else ("jan" if root.modo == "anual" else "dom")
                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20

                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            size_hint: None, None
                            width: 18
                            height: root.barra2

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "04h" if root.modo == "diario" else ("fev" if root.modo == "anual" else "seg")

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20

                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            size_hint: None, None
                            width: 18
                            height: root.barra3

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "08h" if root.modo == "diario" else ("mar" if root.modo == "anual" else "ter")

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            size_hint: None, None
                            width: 18
                            height: root.barra4

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]
                        MDLabel:
                            text:
                                "12h" if root.modo == "diario" else ("abr" if root.modo == "anual" else "qua")

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            size_hint: None, None
                            width: 18
                            height: root.barra5

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]
                        MDLabel:
                            text:
                                "16h" if root.modo == "diario" else ("mai" if root.modo == "anual" else "qui")

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            size_hint: None, None
                            width: 18
                            height: root.barra6

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]
                        MDLabel:
                            text:
                                "20h" if root.modo == "diario" else ("jun" if root.modo == "anual" else "sex")

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            opacity: 1 if self.height > 0 else 0
                            size_hint: None, None
                            width: 18
                            height: root.barra7

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "" if root.modo == "diario" else ("jul" if root.modo == "anual" else "sab")

                            halign: "center"
