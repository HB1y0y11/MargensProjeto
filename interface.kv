                        MDLabel:
                            text:
                                "" if root.modo != "anual" else "set"

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            opacity: 1 if self.height > 0 else 0
                            size_hint: None, None
                            width: 18
                            height: root.barra10

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "" if root.modo != "anual" else "out"

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            opacity: 1 if self.height > 0 else 0
                            size_hint: None, None
                            width: 18
                            height: root.barra11

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "" if root.modo != "anual" else "nov"

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20
                    MDBoxLayout:
                        orientation: "vertical"

                        Widget:

                        Widget:
                            opacity: 1 if self.height > 0 else 0
                            size_hint: None, None
                            width: 18
                            height: root.barra12

                            canvas.before:
                                Color:
                                    rgba: 0.5,0.75,0.68,1

                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [5]

                        MDLabel:
                            text:
                                "" if root.modo != "anual" else "dez"

                            halign: "center"
                            font_size: 9
                            size_hint_y: None
                            height: 20


<Aparelhos>:
    name: "aparelhos"

    MDBoxLayout:
        orientation: "vertical"
        spacing: 20
        padding: [20, 20, 20, 20]

        canvas.before:
            Color:
                rgba: 1,1,1,1
            Rectangle:
                pos: self.pos
                size: self.size

        MDBoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10

            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 0.2, 0.05, 0.18, 1
                ripple_behavior: False

                on_release:
                    app.root.ids.screen_manager.current = "home"
                    app.root.ids.screen_manager.transition.direction = "right"

            MDLabel:
                text: "Aparelhos"
                bold: True
                font_size: 22
                color: 0.2, 0.05, 0.18, 1
                valign: "middle"

        Widget:
            size_hint_y: None
            height: 20

        MDLabel:
            text: "Meus aparelhos"
            bold: True
            font_size: 20
            color: 0.2, 0.05, 0.18, 1
            size_hint_y: None
            height: self.texture_size[1]

        MDGridLayout:
            cols: 2
            spacing: 20
            adaptive_height: True
            size_hint_y: None
            height: self.minimum_height

            MDCard:
                orientation: "vertical"
                radius: [22]
                ripple_behavior: False
                padding: 0
                size_hint_y: None
                height: 170

                md_bg_color: 0.97,0.97,0.97,1

                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.1

                    RoundedRectangle:
                        pos: self.x, self.y - 6
                        size: self.width, self.height
                        radius: [22]

                on_release:
                    app.root.ids.screen_manager.current = "geladeira"
                    app.root.ids.screen_manager.transition.direction = "left"

                MDBoxLayout:
                    size_hint_y: None
                    height: 60
                    padding: [18, 0, 12, 0]
                    spacing: 16

                    canvas.before:
                        Color:
                            rgba: 0.85,0.93,0.88,1

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [22,22,0,0]

                    MDIcon:
                        icon: "fridge-outline"
                        theme_text_color: "Custom"
                        text_color: 0.5,0.75,0.65,1
                        font_size: 26

                    MDLabel:
                        text: "Geladeira"
                        color: 0.4,0.4,0.4,1

                MDBoxLayout:
                    orientation: "vertical"
                    padding: 12
                    spacing: 8

                    MDLabel:
                        text: root.status_geladeira
                        bold: True
                        font_size: 14
                        adaptive_height: True

                        color:
                            (0.3,0.8,0.5,1) if root.status_geladeira == "Ligado" else (1,0.3,0.3,1)

                    MDBoxLayout:
                        spacing: 10
                        adaptive_height: True

                        FloatLayout:
                            size_hint: None, None
                            size: 50, 50

                            canvas:

                                Color:
                                    rgba: 0.9,0.9,0.9,1

                                Line:
                                    width: 6
                                    circle: (self.center_x, self.center_y, 18)

                                Color:
                                    rgba: 0.4,0.8,0.7,1

                                Line:
                                    width: 6
                                    cap: "round"
                                    circle:
                                        (self.center_x, self.center_y, 18, 0,
                                        360 * root.porcentagem_geladeira)

                        MDLabel:
                            text: f"{root.watts_geladeira} W usados"
                            valign: "middle"
                            color: 0.4,0.4,0.4,1

            MDCard:
                orientation: "vertical"
                radius: [22]
                ripple_behavior: True
                size_hint_y: None
                height: 170
                ripple_behavior: False

                md_bg_color: 0.97,0.97,0.97,1

                canvas.before:
                    Color:
                        rgba: 0, 0, 0, 0.1

                    RoundedRectangle:
                        pos: self.x, self.y - 6
                        size: self.width, self.height
                        radius: [22]

                on_release:
                    app.root.ids.screen_manager.current = "ventilador"
                    app.root.ids.screen_manager.transition.direction = "left"

                MDBoxLayout:
                    size_hint_y: None
                    height: 60
                    padding: [20, 0, 12, 0]
                    spacing: 20

                    canvas.before:
                        Color:
                            rgba: 0.85,0.93,0.88,1

                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [22,22,0,0]

                    MDIcon:
                        icon: "fan"
                        theme_text_color: "Custom"
                        text_color: 0.5,0.75,0.65,1
                        font_size: 26

                    MDLabel:
                        text: "Ventilador"
                        color: 0.4,0.4,0.4,1

                MDBoxLayout:
                    orientation: "vertical"
                    padding: 12
                    spacing: 10

                    MDLabel:
                        text: root.status_ventilador
                        bold: True
                        font_size: 14
                        adaptive_height: True

                        color:
                            (0.3,0.8,0.5,1) if root.status_ventilador == "Ligado" else (1,0.3,0.3,1)

                    MDBoxLayout:
                        spacing: 10
                        adaptive_height: True

                        FloatLayout:
                            size_hint: None, None
                            size: 50, 50

                            canvas:

                                Color:
                                    rgba: 0.9,0.9,0.9,1

                                Line:
                                    width: 6
                                    circle: (self.center_x, self.center_y, 18)

                                Color:
                                    rgba: 0.4,0.8,0.7,1

                                Line:
                                    width: 6
                                    cap: "round"
                                    circle:
                                        (self.center_x, self.center_y, 18, 0,
                                        360 * root.porcentagem_ventilador)

                        MDLabel:
                            text: f"{root.watts_ventilador} W usados"
                            valign: "middle"
                            color: 0.4,0.4,0.4,1

            MDCard:
                radius: [22]
                size_hint_y: None
                height: 170
                md_bg_color: 0.97,0.97,0.97,1

                canvas.before:
                    Color:
                        rgba: 0.85,0.93,0.88,1

                    RoundedRectangle:
                        pos: self.x, self.top - 45
                        size: self.width, 45
                        radius: [22,22,0,0]

        Widget:

        MDFloatingActionButton:
            elevation: 0
            icon: "plus"
            ripple_behavior: False
            pos_hint: {"center_x": .88}
            md_bg_color: 0.9,0.8,0.95,1
            icon_color: 0.3,0.1,0.3,1

<Geladeira>:
    name: "geladeira"
    on_enter: self.carregar_dados()

    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: 1, 1, 1, 1
        spacing: 0
        padding: 0

        # HEADER FIXO NO TOPO
        MDBoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10

            MDIconButton:
                icon: "arrow-left"
                theme_icon_color: "Custom"
                icon_color: 0.2, 0.05, 0.18, 1
                ripple_behavior: False

                on_release:
                    app.root.ids.screen_manager.current = "aparelhos"
                    app.root.ids.screen_manager.transition.direction = "right"

            MDLabel:
                text: "Geladeira"
                bold: True
                font_size: 22
                color: 0.2, 0.05, 0.18, 1
                valign: "middle"

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(70)
            padding: [dp(30), 0, dp(30), 0]

        # GRÁFICO CIRCULAR (GAUGE COPIADO)
        FloatLayout:
            size_hint_y: None
            height: dp(220)
            halign: "center"

            canvas:
                Color:
                    rgba: 0.85, 0.9, 0.88, 1
                Line:
                    width: dp(16)
                    circle: (self.center_x, self.center_y + 10, dp(85), -90, 90)
                Color:
                    rgba: 0.45, 0.7, 0.65, 1
                Line:
                    width: dp(16)
                    circle: (self.center_x, self.center_y + 10, dp(85), -90, -90 + (180 * root.porcentagem))

            MDLabel:
                text: f"{root.kw_dia}"
                font_size: dp(38)
                bold: True
                halign: "center"
                color: 0.2, 0.05, 0.18, 1
                pos_hint: {"center_x": .5, "center_y": .48}

            MDLabel:
                text: "kw / dia"
                font_size: dp(16)
                halign: "center"
                color: 0.7, 0.7, 0.7, 1
                pos_hint: {"center_x": .5, "center_y": .32}

            MDCard:
                size_hint: None, None
                size: dp(120), dp(38)
                pos_hint: {"center_x": .5, "y": 0}
                radius: [dp(16)]
                md_bg_color: 0.87, 0.95, 0.9, 1
                elevation: 0

                MDLabel:
                    text: root.data_atual
                    halign: "center"
                    bold: True
                    color: 0.5, 0.7, 0.6, 1

        Widget:
            size_hint_y: None
            height: dp(5)

        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(70)
            padding: [dp(30), 0, dp(30), 0]

        # TÍTULO DO GRÁFICO
        MDLabel:
            text: "kw / dia"
            bold: True
            font_size: dp(15)
            padding: [dp(30), 0, dp(30), 0]
            color: 0.2, 0.05, 0.18, 1
            size_hint_y: None
            height: self.texture_size[1]

        # ÁREA DE BARRAS RECALIBRADA E CORRIGIDA
        MDBoxLayout:
            size_hint_y: None
            height: dp(180)
            spacing: dp(8)
            padding: [dp(12), dp(10), dp(12), 0]

            # EIXO Y COM TEXTO ALINHADO ÀS LINHAS
            MDBoxLayout:
                orientation: "vertical"
                size_hint_x: None
                width: dp(35)
                padding: [0, dp(18), 0, dp(15)]

                MDLabel:
                    text: "360"
                    font_size: dp(11)
                    halign: "right"
                    color: 0.6, 0.6, 0.6, 1
                Widget:
                MDLabel:
                    text: "180"
                    font_size: dp(11)
                    halign: "right"
                    color: 0.6, 0.6, 0.6, 1
                Widget:
                MDLabel:
                    text: "0"
                    font_size: dp(11)
                    halign: "right"
                    color: 0.6, 0.6, 0.6, 1

            # CHÃO MATEMÁTICO RÍGIDO (Gráfico de Barras)
            MDRelativeLayout:
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 0.6
                    Line:
                        points: [0, self.height - dp(25), self.width, self.height - dp(25)]
                        width: 1
                        dash_length: dp(3)
                        dash_offset: dp(3)

                    Color:
                        rgba: 0.88, 0.88, 0.88, 1
                    Line:
                        points: [0, (self.height - dp(45)) / 2 + dp(20), self.width, (self.height - dp(45)) / 2 + dp(20)]
                        width: 1

                    Color:
                        rgba: 0.35, 0.35, 0.35, 1
                    Line:
                        points: [0, dp(20), self.width, dp(20)]
                        width: 1.5

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(10)
                    size_hint: 1, 1
                    pos_hint: {"x": 0, "y": -0.09}

                    # DOMINGO
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia1)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11} # 0.11 afasta precisamente da base preta
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia1 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "dom"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # SEGUNDA
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia2)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia2 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "seg"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # TERÇA
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia3)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia3 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "ter"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # QUARTA
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia4)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia4 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "qua"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # QUINTA
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia5)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia5 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "qui"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # SEXTA
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia6)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia6 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "sex"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

                    # SÁBADO
                    MDBoxLayout:
                        orientation: "vertical"
                        MDFloatLayout:
                            Widget:
                                size_hint: (None, root.dia7)
                                width: dp(16)
                                pos_hint: {"center_x": .5, "y": 0.11}
                                canvas.before:
                                    Color:
                                        rgba: (0.5, 0.75, 0.68, 1) if root.dia7 > 0 else (0.93, 0.93, 0.93, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(4), dp(4), 0, 0]
                        MDLabel:
                            text: "sab"
                            halign: "center"
                            font_size: dp(11)
                            color: 0.5, 0.5, 0.5, 1
                            size_hint_y: None
                            height: dp(20)

        # ESPAÇADOR ELÁSTICO FINAL (Força o cabeçalho a ficar colado no teto)
        Widget:
            size_hint_y: 1

<Ventilador>:
    name: "ventilador"

    MDLabel:
        text: "Tela Ventilador"
        halign: "center"

    MDIconButton:
        icon: "arrow-left"
        ripple_behavior: False

        on_release:
            app.root.ids.screen_manager.current = "aparelhos"
            app.root.ids.screen_manager.transition.direction = "right"
            
<Ideias>:
    name: "ideias"

    # Forçamos um fundo branco sólido para a tela inteira. Isso elimina de vez os "fantasmas" atrás do Carousel.
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    MDBoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15) # Reduzido levemente para equilibrar o espaço vertical

        # TÍTULO 1
        MDLabel:
            text: "Economia consciente"
            font_style: "H6" # Dá um destaque elegante de título profissional
            bold: True
            size_hint_y: None
            height: self.texture_size[1]
            color: 0.2, 0.05, 0.18, 1

        # CARROSSEL DE DICAS
        MDCarousel:
            id: dicas_carousel
            size_hint_y: None
            height: dp(180)

            FitImage:
                source: "images/dica1.png"
                radius: [dp(20),]

            FitImage:
                source: "images/dica2.png"
                radius: [dp(20),]

            FitImage:
                source: "images/dica3.png"
                radius: [dp(20),]

        # TÍTULO 2
        MDLabel:
            text: "Pontos e recompensas"
            font_style: "Subtitle1"
            bold: False # Forçado False para garantir que não fique negrito
            size_hint_y: None
            height: self.texture_size[1]
            color: 0.2, 0.05, 0.18, 1

        # CARDS DESLIZÁVEIS
        ScrollView:
            do_scroll_y: False
            do_scroll_x: True
            size_hint_y: None
            height: dp(140)

            MDBoxLayout:
                adaptive_width: True
                spacing: dp(15)
                padding: [0, 0, dp(20), 0]

                MDCard:
                    size_hint: None, None
                    size: dp(140), dp(120) # Aumentado largura para caber o conteúdo confortavelmente
                    radius: [15,]
                    md_bg_color: 0.95, 0.95, 0.95, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(5)

                        MDLabel:
                            text: "Ler dicas"
                            bold: True
                            font_size: "14sp"

                        MDLabel:
                            text: "+50 pontos"
                            font_size: "12sp"
                            color: 0.4, 0.7, 0.5, 1

                        MDRaisedButton:
                            text: "Resgatar"
                            size_hint_x: 1
                            font_size: "11sp"

                MDCard:
                    size_hint: None, None
                    size: dp(140), dp(120)
                    radius: [15,]
                    md_bg_color: 0.95, 0.95, 0.95, 1

                    MDBoxLayout:
                        orientation: "vertical"
                        padding: dp(10)
                        spacing: dp(5)

                        MDLabel:
                            text: "Economizar"
                            bold: True
                            font_size: "14sp"

                        MDLabel:
                            text: "+200 pontos"
                            font_size: "12sp"
                            color: 0.4, 0.7, 0.5, 1

                MDCard:
                    size_hint: None, None
                    size: dp(140), dp(120)
                    radius: [15,]
                    md_bg_color: 0.95, 0.95, 0.95, 1

        # BOTÃO VER PRÊMIOS CORRIGIDO
        MDTextButton:
            text: "Ver prêmios"
            theme_text_color: "Custom"      # Obrigatório para o KivyMD aceitar sua cor customizada
            text_color: 0.5, 0.5, 0.5, 1    # Substitui a propriedade 'color' que falhava
            font_size: "12sp"               # Define o tamanho pequeno desejado usando sp estável
            pos_hint: {"center_x": .15}

        # TÍTULO 3
        MDLabel:
            text: "Meus hábitos"
            font_style: "Subtitle1"
            bold: False # Forçado False para não herdar negrito indesejado
            size_hint_y: None
            height: self.texture_size[1]
            color: 0.2, 0.05, 0.18, 1

        MDRaisedButton:
            text: "▼ maio"
            size_hint: None, None
            size: dp(90), dp(35)
            md_bg_color: .85, .95, .88, 1
            text_color: .4, .7, .5, 1

        # SEÇÃO INFERIOR DE HÁBITOS
        MDBoxLayout:
            spacing: dp(20)
            size_hint_y: None
            height: dp(80) # Trava a altura para organizar a proporção da tela

            # LADO ESQUERDO
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(5)

                MDLabel:
                    text: "Economia mensal"
                    halign: "center"
                    font_size: "14sp"
                    color: 0.5, 0.5, 0.5, 1

                MDLabel:
                    text: "X %"
                    halign: "center"
                    font_size: "24sp"
                    bold: True
                    color: 0.2, 0.05, 0.18, 1

            # LADO DIREITO
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(2)

                MDLabel:
                    text: "Total economizado"
                    font_size: "13sp"
                    color: 0.5, 0.5, 0.5, 1

                MDLabel:
                    text: "XXX Kw"
                    font_size: "24sp"
                    bold: True
                    color: 0.2, 0.05, 0.18, 1

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(8)
                    
                    MDLabel:
                        text: "Rendimento"
                        font_size: "13sp"
                        size_hint_x: None
                        width: self.texture_size[0]

                    MDChip:
                        text: "Positivo"
                        elevation: 0
                        size_hint_y: None
                        height: dp(24)

        # O Widget elástico final que joga tudo estruturado para o topo da tela,
        # impedindo que o menu inferior ou resoluções diferentes esmaguem seu layout.
        Widget:
            size_hint_y: 1